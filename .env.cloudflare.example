# The app uses Workers Free + D1 Free + static assets on a workers.dev address.
# Keep the Cloudflare account's Workers plan on Free. No card or paid add-on is
# needed by this deployment script; live signup requirements are account-specific.
# Prefer secure environment settings. Never share these values in chat.

# Account-scoped token: Workers Scripts Edit + D1 Edit.
# Account Settings Read may also be needed to read the workers.dev subdomain.
CLOUDFLARE_API_TOKEN=

# The 32-character hexadecimal Account ID shown in the Cloudflare dashboard.
CLOUDFLARE_ACCOUNT_ID=

# Choose a private, single-line setup code with at least 16 characters.
# The owner enters it once when creating their account on the deployed app.
ADMIN_INVITE_CODE=
