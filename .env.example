# Local development. Use production + HTTPS when deploying.
NODE_ENV=development
PORT=3001
DB_PATH=.data/hisab.sqlite
# Vite development frontend. For a local npm start build, use port 3001 instead.
# Production requires the app's external HTTPS origin, without a path.
PUBLIC_BASE_URL=http://localhost:5173
TRUST_PROXY=false

# Production first startup requires a long, unique private setup code.
# It can be removed after the owner exists. Leave empty only for trusted local setup.
ADMIN_INVITE_CODE=

# Optional automatic WhatsApp delivery through Meta's Cloud API.
# Leave these empty to use the manual Open WhatsApp button.
# Store real values securely; never commit .env.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional safeguard for the sender check: international digits, without +.
# This is the business sending number; the Phone Number ID above is a separate Meta ID.
WHATSAPP_EXPECTED_NUMBER=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_GRAPH_VERSION=v23.0

# Webhook callback: PUBLIC_BASE_URL + /api/whatsapp/webhook
# Meta must reach the callback over HTTPS; outbound API calls use graph.facebook.com.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
