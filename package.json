{
  "name": "hisab-advance-register",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.10.0"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "build:preview": "node scripts/build-preview.js",
    "start": "node --use-env-proxy --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "test:ui": "playwright test tests/ui.spec.js --workers=1",
    "test:cloudflare-ui": "playwright test tests/cloudflare-ui.spec.js --workers=1",
    "test:preview": "playwright test tests/preview.spec.js tests/preview-mobile.spec.js --workers=1",
    "whatsapp:check": "node --use-env-proxy --env-file-if-exists=.env scripts/check-whatsapp.js",
    "dev:free": "wrangler dev --local",
    "deploy:free": "node --use-env-proxy --env-file-if-exists=.env.cloudflare scripts/deploy-free.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js"
  },
  "dependencies": {
    "lucide-react": "1.69.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "miniflare": "5.20261104.0-beta",
    "vite": "8.3.6",
    "wrangler": "4.158.0"
  }
}
